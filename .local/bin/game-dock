#!/usr/bin/env bash
# game-dock -- numbered quick launcher for this machine's games.
#
# Bound to XF86Mail (the envelope key) in ~/.config/hypr/zafon.lua. Pressing a
# number launches that game through Lutris and closes the dock; q or Esc closes
# without launching.
#
# The list lives in ~/.config/game-dock/games.conf, one game per line:
#     Label|command
# The line order is the number you press. Edit that file to add, remove or
# reorder games -- this script never needs to change.
#
# Run with no arguments from a terminal to show the menu in place; run it from a
# Hyprland keybind (no TTY) and it re-execs itself inside a floating foot window.

set -u

conf="${XDG_CONFIG_HOME:-$HOME/.config}/game-dock/games.conf"
self="$(readlink -f "$0")"

if [[ ! -r "$conf" ]]; then
  printf 'game-dock: missing %s\n' "$conf" >&2
  printf 'Create it with lines like:  PES 2013|%s lutris:rungameid/5\n' \
    "$HOME/.local/bin/lutris" >&2
  exit 1
fi

labels=()
cmds=()
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" || "$line" == \#* ]] && continue
  labels+=("${line%%|*}")
  cmds+=("${line#*|}")
done < "$conf"

n=${#labels[@]}
if (( n == 0 )); then
  printf 'game-dock: no games in %s\n' "$conf" >&2
  exit 1
fi

# No controlling terminal (e.g. launched from a Hyprland keybind): open the
# menu in its own small window. foot sets the app-id, which zafon.lua floats
# and centres. Size it from the entry count: three header lines, the list,
# and four prompt/blank lines. A fixed height scrolled the top rule away as
# soon as a sixth game was added.
if [[ ! -t 0 ]]; then
  exec foot --app-id=game-dock --title=Games \
    --window-size-chars="46x$((n + 8))" \
    -e "$self" "$@"
fi

# Build the header from one width so the rules and both side borders line up.
# The old title row had 37 cells inside the border while the rules had 36,
# which pushed its right edge a cell out.
inner_width=36
title=$'󰖺  G A M E S'
# CaskaydiaMono Nerd Font Mono advances the controller glyph exactly one cell,
# so the title is 12 cells. The extra gap after the icon balances the glyphs'
# ink visually around the middle of the 36-cell rule.
title_width=12
pad_left=$(( (inner_width - title_width) / 2 ))
pad_right=$(( inner_width - title_width - pad_left ))
printf -v left '%*s' "$pad_left" ''
printf -v right '%*s' "$pad_right" ''
printf -v rule '%*s' "$inner_width" ''
rule=${rule// /─}

clear
printf '\033[1;36m'
printf '  ╭%s╮\n' "$rule"
printf '  │%s%s%s│\n' "$left" "$title" "$right"
printf '  ╰%s╯\n' "$rule"
printf '\033[0m\n'

for i in "${!labels[@]}"; do
  printf '   \033[1;33m%2d\033[0m  %s\n' "$((i + 1))" "${labels[$i]}"
done

printf '\n   \033[2mq / Esc  close\033[0m\n\n'
printf '  \033[1mLaunch:\033[0m '

while true; do
  IFS= read -rsn1 key || exit 0
  case "$key" in
    q|Q|$'\e') exit 0 ;;
    [1-9])
      idx=$((key - 1))
      if (( idx >= 0 && idx < n )); then
        # setsid, and do not exit until it has left this session.
        #
        # The dock closes its foot window right after this, and foot kills the
        # pty's process group on the way out -- nohup does not survive it
        # (nohup only ignores SIGHUP), so the game died with the window.
        # setsid puts the launcher in its own session with no controlling
        # terminal, where foot's signal cannot reach it. But fork/exec/setsid
        # takes a moment, and exiting at once races that: foot sometimes kills
        # the child before it manages to call setsid(). So wait until the
        # launcher reports a different session id, and only then let the window
        # close (bounded, in case it already exited).
        setsid bash -c "${cmds[$idx]}" </dev/null >/tmp/game-dock.log 2>&1 &
        launcher=$!
        for _ in {1..50}; do
          ss=$(ps -o sid= -p "$$" 2>/dev/null | tr -d ' ')
          ls_sid=$(ps -o sid= -p "$launcher" 2>/dev/null | tr -d ' ')
          [[ -z "$ls_sid" || "$ls_sid" != "$ss" ]] && break
          sleep 0.02
        done
        exit 0
      fi
      ;;
  esac
done
