#!/usr/bin/env bash
# game-dock -- numbered quick launcher for this machine's games.
#
# Bound to XF86Mail (the envelope key) in ~/.config/hypr/zafon.lua. Pressing a
# number launches that game through Lutris and closes the dock; q or Esc closes
# without launching.
#
# The list lives in ~/.config/game-dock/games.conf, one game per line:
#     Label|command
# The line order is the number you press. Edit that file to add, remove or
# reorder games -- this script never needs to change.
#
# Run with no arguments from a terminal to show the menu in place; run it from a
# Hyprland keybind (no TTY) and it re-execs itself inside a floating foot window.

set -u

conf="${XDG_CONFIG_HOME:-$HOME/.config}/game-dock/games.conf"
self="$(readlink -f "$0")"

# No controlling terminal (e.g. launched from a Hyprland keybind): open the
# menu in its own small window. foot sets the app-id, which zafon.lua floats
# and centres.
if [[ ! -t 0 ]]; then
  exec foot --app-id=game-dock --title=Games \
    --window-size-chars=46x12 \
    -e "$self" "$@"
fi

if [[ ! -r "$conf" ]]; then
  printf 'game-dock: missing %s\n' "$conf" >&2
  printf 'Create it with lines like:  PES 2013|%s lutris:rungameid/5\n' \
    "$HOME/.local/bin/lutris" >&2
  exit 1
fi

labels=()
cmds=()
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" || "$line" == \#* ]] && continue
  labels+=("${line%%|*}")
  cmds+=("${line#*|}")
done < "$conf"

n=${#labels[@]}
if (( n == 0 )); then
  printf 'game-dock: no games in %s\n' "$conf" >&2
  exit 1
fi

clear
printf '\033[1;36m'
printf '  \xe2\x95\xad\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x95\xae\n'
printf '  \xe2\x94\x82  G A M E S                          \xe2\x94\x82\n'
printf '  \xe2\x95\xb0\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x95\xaf\n'
printf '\033[0m\n'

for i in "${!labels[@]}"; do
  printf '   \033[1;33m%2d\033[0m  %s\n' "$((i + 1))" "${labels[$i]}"
done

printf '\n   \033[2mq / Esc  close\033[0m\n\n'
printf '  \033[1mLaunch:\033[0m '

while true; do
  IFS= read -rsn1 key || exit 0
  case "$key" in
    q|Q|$'\e') exit 0 ;;
    [1-9])
      idx=$((key - 1))
      if (( idx >= 0 && idx < n )); then
        nohup bash -c "${cmds[$idx]}" >/tmp/game-dock.log 2>&1 &
        exit 0
      fi
      ;;
  esac
done
