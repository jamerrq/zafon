# --- Status Bar (Bumblebee Status) ---
# https://bumblebee-status.readthedocs.io/en/main/modules.html
bar {
	font pango:Font Awesome, ShureTechMono Nerd Font Bold 10.5
	position bottom
	tray_output none
	status_command ~/.config/bumblebee-status/bumblebee-status \
                -m disk:root memory load datetime \
                   pasink pasource capslock \
		-a nic \
		-p root.path=/ time.format="%H:%M CW %V" date.format="%a, %b %d %Y" \
                   disk.format="{percent:05.02f}%" \
                   datetime.format="%a, %d %b %Y [󰨳 {roman_week}]  %H:%M" \
                   memory.format="{percent:05.02f}%" cpu.format="{:.01f}%" \
                   spacer.text="🚬 LXIV" disk.warning=85 \
                   load.warning=90 load.critical=95 \
		-t iceberg-rainbow
  colors {
    background #000000
    statusline #328E6E
    separator  #328E6E

    focused_workspace  #328E6E #328E6E #FFFFFF
    active_workspace   #333333 #222222 #FFFFFF
    inactive_workspace #333333 #222222 #888888
    urgent_workspace   #2F343A #900000 #FFFFFF
    binding_mode       #2F343A #900000 #FFFFFF
  }
}
