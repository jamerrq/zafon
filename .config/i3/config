# --- Keybindings: Launching ---
bindsym $mod+Return exec $term

bindsym $mod+d exec --no-startup-id rofi -show drun -show-icons
bindsym $mod+Shift+d exec --no-startup-id rofi -show run -show-icons
bindsym $mod+Shift+e exec --no-startup-id rofi -modi "scripts:~/dev/scripts/bash/dmenu-scripts.sh" -show scripts

bindsym $mod+Shift+q kill

# --- Keybindings: Focus ---
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# --- Keybindings: Move ---
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Also use $mod+arrow(s)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- Keybindings: Split ---
bindsym $mod+v split v
bindsym $mod+b split h

# --- Keybindings: Layouts ---
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split

# --- Workspaces ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "0"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# --- Floating Rules ---
bindsym $mod+Shift+space floating toggle

for_window [class="confirmreset"] floating enable
for_window [class="toolbar"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="Gpick"] floating enable
for_window [class="Kruler"] floating enable
for_window [class="MessageWin"] floating enable
for_window [class="Sxiv"] floating enable
for_window [class="Wpa_gui"] floating enable
for_window [class="pinentry"] floating enable
for_window [class="veromix"] floating enable
for_window [class="xtightvncviewer"] floating enable
for_window [title="Event Tester"] floating enable

# --- Window Marks ---
bindsym $mod+m mark mywindow
bindsym $mod+g [con_mark="mywindow"] focus

# --- Config Reload/Exit ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# --- Redshift ---
bindsym $mod+x exec --no-startup-id redshift -O 4000
bindsym $mod+Shift+x exec --no-startup-id redshift -x

# --- Power Menu ---
set $mode_system  \
      [l(ock)] [e(logout)] [s(uspend)] [h(ibernate)] [r(eboot)] [P(oweroff)]

set $lock_script bash ~/dev/scripts/bash/lock.sh
mode "$mode_system" {
    bindsym l exec --no-startup-id $lock_script, mode "default"
    bindsym s exec --no-startup-id $lock_script --suspend, mode "default"
    bindsym h exec --no-startup-id $lock_script --hibernate, mode "default"
    bindsym r exec --no-startup-id $lock_script --reboot, mode "default"
    bindsym shift+p exec --no-startup-id $lock_script --shutdown, mode "default"
    bindsym e exec --no-startup-id i3-nagbar \
            -f "pango:ShureTechMono Nerd Font Mono Bold 11" -t warning \
            -m 'end session?' -b 'yes' 'i3-msg exit', mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+BackSpace mode "$mode_system"

