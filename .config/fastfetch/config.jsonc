{
    "logo": {
        "type": "auto",        // Logo type: auto, builtin, small, file, etc.
        "width": 65,           // Width in characters (for image logos)
        "height": 35,          // Height in characters (for image logos)
        "padding": {
            "top": 0,          // Top padding
            "left": 2,         // Left padding
            "right": 2,         // Right padding
            "bottom": 4          // Bottom padding
        },
        "color": {             // Override logo colors
            "1": "#D6DAC8",
            "2": "#9CAFAA"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#9CAFAA",    // Key color
            "title": "#D6DAC8"     // Title color
        },
        "bar": {
            "width": 10,       // Width of percentage bars
            "charElapsed": "■", // Character for elapsed portion
            "charTotal": "-"   // Character for total portion
        },
        "percent": {
            "type": 3,         // 1=number, 2=bar, 3=both, 9=colored number
            "color": {
                "green": "#9CAFAA",
                "yellow": "light_yellow",
                "red": "light_red"
            }
        }
    },
    "modules": [
        "break",
        {
            "type": "host",
            "key": "󰒋"
        },
        {
            "type": "cpu",
            "key": "│ "
        },
        {
            "type": "gpu",
            "key": "│ ",
            "format": "GPU {driver} @ {frequency}"
        },
        {
            "type": "memory",
            "key": "│ "
        },
        {
            "type": "disk",
            "key": "│ 󰋊"
        },
        "break",
        {
            "type": "os",
            "key": ""
        },
        {
            "type": "kernel",
            "key": "│ "
        },
        {
            "type": "bios",
            "key": "│ "
        },
        {
            "type": "packages",
            "key": "│ 󰏖"
        },
        {
            "type": "shell",
            "key": "│ "
        },
        "break",
        {
            "type": "de",
            "key": " DE"
        },
        {
            "type": "wm",
            "key": "│ "
        },
        {
            "type": "wmtheme",
            "key": "│ 󰉼"
        },
        {
            "type": "terminal",
            "key": "└ "
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
