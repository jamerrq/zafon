#!/bin/bash

# Yadm bootstrap. Runs automatically after `yadm clone`, and is safe to re-run.

set -uo pipefail

ZAFON="$HOME/.config/yadm/zafon"

echo "Bootstrapping capablanca customizations..."

if [[ ! -f $ZAFON ]]; then
  echo "Error: $ZAFON not found. Is the yadm clone complete?" >&2
  exit 1
fi
chmod +x "$ZAFON" "$HOME/.config/yadm/zafon.d"/*.sh 2>/dev/null

# Make zafon available on PATH for later interactive use. ~/.local/bin precedes
# Omarchy's bin via .config/environment.d/10-zafon-path.conf.
mkdir -p "$HOME/.local/bin"
ln -sfn "$ZAFON" "$HOME/.local/bin/zafon"

# Non-interactive: apply everything except modules flagged optional (those need
# sudo or make system-wide changes, so they stay an explicit choice).
"$ZAFON" apply --yes

echo
echo "Bootstrap complete."
echo "  - run 'zafon check' to verify"
echo "  - run 'zafon apply' to pick up the optional steps (ACPI wakeup fix)"
echo "  - log out and back in so ~/.local/bin takes effect for Hyprland"
