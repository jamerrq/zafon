#!/bin/bash

# zafon -- apply and verify the capablanca customizations over Omarchy.
#
# Each customization is a self-contained module in zafon.d/ exposing two verbs:
#
#   check   report state, change nothing.  0 = ok, 1 = drift, 2 = missing, 3 = error
#   apply   bring it into the desired state
#
# Modules are separate executables rather than sourced functions so that one
# broken module cannot take down the whole run, and so each can be tested alone.

set -uo pipefail

VERSION="0.1.0"
MODULE_DIR="${ZAFON_MODULE_DIR:-$HOME/.config/yadm/zafon.d}"

VERBOSE=false
SILENT=false
ASSUME_YES=false
ONLY=""
USE_COLOR=true

# ---------------------------------------------------------------------------
# output

setup_colors() {
  if [[ $USE_COLOR == true && -t 1 ]]; then
    RED=$'\e[31m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; BLUE=$'\e[34m'
    DIM=$'\e[2m'; BOLD=$'\e[1m'; NC=$'\e[0m'
  else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; DIM=""; BOLD=""; NC=""
  fi
}

say() { [[ $SILENT == true ]] || printf '%s\n' "$*"; }
err() { printf '%s\n' "$*" >&2; }
detail() { [[ $VERBOSE == true && $SILENT != true ]] && printf '%s\n' "$*"; }

# Endpoints of the banner gradient, as R,G,B. Override to retheme.
ZAFON_GRADIENT_FROM="${ZAFON_GRADIENT_FROM:-0,229,255}"
ZAFON_GRADIENT_TO="${ZAFON_GRADIENT_TO:-255,47,185}"

truecolor_ok() {
  # 24-bit escapes come out as garbage on terminals that do not support them,
  # so this errs toward the flat fallback. ZAFON_GRADIENT=always|never wins.
  case ${ZAFON_GRADIENT:-auto} in
    always) return 0 ;;
    never) return 1 ;;
  esac
  [[ $USE_COLOR == true && -t 1 ]] || return 1
  [[ ${COLORTERM:-} == truecolor || ${COLORTERM:-} == 24bit ]] && return 0
  # COLORTERM is not always exported, so fall back to recognising terminals
  # that are known to handle truecolor.
  case ${TERM:-} in
    *alacritty*|*kitty*|*ghostty*|*foot*|*wezterm*|*contour*) return 0 ;;
  esac
  return 1
}

gradient_line() {
  # Paint one line left-to-right between the two endpoint colors.
  local line=$1
  local -i len=${#line}
  ((len)) || { printf '\n'; return; }

  local -i r1 g1 b1 r2 g2 b2
  IFS=, read -r r1 g1 b1 <<<"$ZAFON_GRADIENT_FROM"
  IFS=, read -r r2 g2 b2 <<<"$ZAFON_GRADIENT_TO"

  local -i i r g b span=$((len > 1 ? len - 1 : 1))
  local out=""
  for ((i = 0; i < len; i++)); do
    r=$((r1 + (r2 - r1) * i / span))
    g=$((g1 + (g2 - g1) * i / span))
    b=$((b1 + (b2 - b1) * i / span))
    # ${line:i:1} is character-wise, not byte-wise, in a UTF-8 locale -- which
    # matters because the art is drawn with multibyte block characters.
    out+=$'\e['"38;2;$r;$g;${b}m${line:i:1}"
  done
  printf '%s\e[0m\n' "$out"
}

banner() {
  [[ $SILENT == true ]] && return
  # The art lives in its own file so it can be edited freely without touching
  # this script. ZAFON_ART points somewhere else if you want a different one.
  local art_file="${ZAFON_ART:-$HOME/.config/yadm/zafon.art}"
  local art line
  if [[ -r $art_file ]]; then
    art=$(<"$art_file")
    if truecolor_ok; then
      while IFS= read -r line; do gradient_line "$line"; done <<<"$art"
    else
      printf '%s%s%s\n' "$BLUE" "$art" "$NC"
    fi
  fi
  printf '%s  capablanca over omarchy%s  %sv%s%s\n\n' "$DIM" "$NC" "$DIM" "$VERSION" "$NC"
}

progress() {
  # progress <done> <total> <label>
  # Redraws in place with \r, which only works on a terminal -- when piped or
  # captured, fall back to one plain line per completed step.
  [[ $SILENT == true ]] && return
  if [[ ! -t 1 ]]; then
    (($1 > 0)) && printf '  [%d/%d] %s\n' "$1" "$2" "${3:-}"
    return
  fi
  local done=$1 total=$2 label=${3:-}
  local width=24
  local filled=$((total > 0 ? done * width / total : 0))
  local pct=$((total > 0 ? done * 100 / total : 0))
  local bar=""
  local i
  for ((i = 0; i < width; i++)); do
    if ((i < filled)); then bar+="█"; else bar+="░"; fi
  done
  printf '\r  %s%s%s %3d%%  %-28s' "$BLUE" "$bar" "$NC" "$pct" "$label"
  ((done >= total)) && printf '\n'
}

# ---------------------------------------------------------------------------
# modules

MOD_PATHS=(); MOD_SLUGS=(); MOD_NAMES=(); MOD_DESCS=(); MOD_OPTIONAL=()

meta() {
  # meta <file> <key> -- read a `# zafon:key=value` header comment
  sed -n "s/^# zafon:$2=//p" "$1" | head -n1
}

discover() {
  local f slug
  [[ -d $MODULE_DIR ]] || { err "module directory not found: $MODULE_DIR"; exit 3; }
  for f in "$MODULE_DIR"/*.sh; do
    [[ -f $f ]] || continue
    slug=$(basename "$f" .sh); slug=${slug#*-}
    if [[ -n $ONLY && ",$ONLY," != *",$slug,"* ]]; then continue; fi
    [[ -x $f ]] || chmod +x "$f" 2>/dev/null
    MOD_PATHS+=("$f")
    MOD_SLUGS+=("$slug")
    MOD_NAMES+=("$(meta "$f" name)")
    MOD_DESCS+=("$(meta "$f" desc)")
    MOD_OPTIONAL+=("$(meta "$f" optional)")
  done
  ((${#MOD_PATHS[@]})) || { err "no modules matched${ONLY:+ --only $ONLY}"; exit 3; }
}

status_label() {
  case $1 in
    0) printf '%sOK%s     ' "$GREEN" "$NC" ;;
    1) printf '%sDRIFT%s  ' "$YELLOW" "$NC" ;;
    2) printf '%sMISSING%s' "$RED" "$NC" ;;
    *) printf '%sERROR%s  ' "$RED" "$NC" ;;
  esac
}

# Populated by run_checks
declare -a RESULTS=() OUTPUTS=()

run_checks() {
  local i out rc
  for i in "${!MOD_PATHS[@]}"; do
    out=$("${MOD_PATHS[$i]}" check 2>&1); rc=$?
    RESULTS[i]=$rc
    OUTPUTS[i]=$out
  done
}

report() {
  local i rc
  for i in "${!MOD_PATHS[@]}"; do
    rc=${RESULTS[$i]}
    [[ $SILENT == true && $rc -eq 0 ]] && continue
    printf '  %s  %s%-22s%s' "$(status_label "$rc")" "$BOLD" "${MOD_NAMES[$i]}" "$NC"
    if [[ $rc -eq 0 ]]; then
      printf '%s%s%s\n' "$DIM" "${OUTPUTS[$i]}" "$NC"
    else
      printf '\n'
      while IFS= read -r line; do
        [[ -n $line ]] && printf '      %s- %s%s\n' "$DIM" "$line" "$NC"
      done <<<"${OUTPUTS[$i]}"
    fi
  done
}

needs_work() {
  # echo indices of modules that are not OK
  local i
  for i in "${!MOD_PATHS[@]}"; do
    [[ ${RESULTS[$i]} -ne 0 ]] && printf '%s\n' "$i"
  done
}

# ---------------------------------------------------------------------------
# commands

cmd_check() {
  banner
  say "${BOLD}Checking customizations...${NC}"
  say ""
  run_checks
  report
  say ""

  local failed=0 i
  for i in "${!MOD_PATHS[@]}"; do [[ ${RESULTS[$i]} -ne 0 ]] && ((failed++)); done

  if ((failed == 0)); then
    say "  ${GREEN}Everything is in place.${NC}"
    return 0
  fi
  say "  ${YELLOW}$failed module(s) need attention.${NC} Run ${BOLD}zafon apply${NC} to fix."
  return 1
}

have_tty() {
  # A controlling terminal we can actually read from. Without this check the
  # prompt below would block forever under cron, a pipe, or a systemd unit.
  [[ -t 0 ]] && return 0
  { : </dev/tty; } 2>/dev/null
}

confirm() {
  # confirm <prompt> -- yes by default, since we only ask about modules that
  # already reported a problem.
  local prompt=$1
  have_tty || return 1

  if command -v gum >/dev/null 2>&1; then
    gum confirm --default=yes "$prompt"
    return $?
  fi

  local reply
  if [[ -t 0 ]]; then
    read -r -p "$prompt [Y/n] " reply || return 1
  else
    read -r -p "$prompt [Y/n] " reply </dev/tty || return 1
  fi
  [[ -z $reply || $reply == [yY]* ]]
}

apply_one() {
  # apply_one <index> -- returns 0 applied, 1 failed, 2 skipped
  local i=$1 out rc

  if [[ $ASSUME_YES != true ]]; then
    say ""
    printf '  %s%s%s\n' "$BOLD" "${MOD_NAMES[$i]}" "$NC"
    while IFS= read -r line; do
      [[ -n $line ]] && printf '      %s- %s%s\n' "$DIM" "$line" "$NC"
    done <<<"${OUTPUTS[$i]}"

    if [[ ${MOD_OPTIONAL[$i]} == true ]]; then
      printf '      %s(optional -- needs sudo)%s\n' "$YELLOW" "$NC"
    fi

    confirm "  Apply ${MOD_NAMES[$i]}?" || { say "  ${DIM}skipped${NC}"; return 2; }
  fi

  out=$("${MOD_PATHS[$i]}" apply 2>&1); rc=$?
  if ((rc != 0)); then
    err "  ${RED}failed:${NC} ${MOD_NAMES[$i]}"
    err "$out"
    return 1
  fi

  if [[ $ASSUME_YES == true ]]; then
    detail "$(printf '  %s%s:%s\n%s' "$DIM" "${MOD_NAMES[$i]}" "$NC" "$out")"
  else
    while IFS= read -r line; do
      [[ -n $line ]] && printf '      %s%s%s\n' "$GREEN" "$line" "$NC"
    done <<<"$out"
  fi
  return 0
}

notify_result() {
  # notify_result <applied> <skipped> <failed> -- always fires, so an unattended
  # run still surfaces its outcome on the desktop.
  local -i applied=$1 skipped=$2 failed=$3
  command -v notify-send >/dev/null 2>&1 || return 0

  local urgency=low icon summary body
  body="$applied applied, $skipped skipped, $failed failed"

  if ((failed)); then
    urgency=critical; icon=dialog-error
    summary="zafon: $failed module(s) failed"
  elif ((applied)); then
    icon=emblem-ok
    summary="zafon: $applied module(s) applied"
  elif ((skipped)); then
    icon=dialog-information
    summary="zafon: nothing applied"
  else
    icon=emblem-ok
    summary="zafon: everything already in place"
    body="no changes were needed"
  fi

  notify-send -u "$urgency" -i "$icon" -t 4000 "$summary" "$body" 2>/dev/null || true
}

cmd_apply() {
  banner
  say "${BOLD}Checking customizations...${NC}"
  say ""
  run_checks
  report
  say ""

  local -a candidates=()
  mapfile -t candidates < <(needs_work)

  if ((${#candidates[@]} == 0)); then
    say "  ${GREEN}Nothing to apply.${NC}"
    notify_result 0 0 0
    return 0
  fi

  # Unattended runs never escalate: modules marked optional need sudo or make
  # system-wide changes, so they stay an explicit choice.
  if [[ $ASSUME_YES == true ]]; then
    local -a filtered=()
    local i
    for i in "${candidates[@]}"; do
      [[ ${MOD_OPTIONAL[$i]} == true ]] && continue
      filtered+=("$i")
    done
    candidates=("${filtered[@]:-}")
    [[ -z ${candidates[0]:-} ]] && candidates=()
    if ((${#candidates[@]} == 0)); then
      say "  ${GREEN}Nothing to apply${NC} (only optional modules need attention; run without --yes)."
      notify_result 0 "${#candidates[@]}" 0
      return 0
    fi
  fi

  if [[ $ASSUME_YES != true ]] && ! have_tty; then
    err "zafon apply needs a terminal to confirm each module."
    err "Run it interactively, or pass --yes to apply without prompting."
    return 3
  fi

  say "  ${BOLD}${#candidates[@]} module(s) need attention.${NC}"

  local -i done=0 applied=0 skipped=0 failed=0
  local i rc
  for i in "${candidates[@]}"; do
    [[ $ASSUME_YES == true && -t 1 ]] && progress "$done" "${#candidates[@]}" "${MOD_NAMES[$i]}"
    apply_one "$i"; rc=$?
    ((done++))
    case $rc in
      0) ((applied++)) ;;
      1) ((failed++)) ;;
      2) ((skipped++)) ;;
    esac
    [[ $ASSUME_YES == true ]] && progress "$done" "${#candidates[@]}" "${MOD_NAMES[$i]}"
  done

  say ""
  say "  ${GREEN}$applied applied${NC}, ${DIM}$skipped skipped${NC}, ${RED}$failed failed${NC}"

  notify_result "$applied" "$skipped" "$failed"

  ((failed)) && return 1
  ((applied)) && say "  Re-run ${BOLD}zafon check${NC} to confirm."
  return 0
}

cmd_list() {
  banner
  local i
  for i in "${!MOD_PATHS[@]}"; do
    printf '  %s%-12s%s %-24s %s%s%s\n' \
      "$BOLD" "${MOD_SLUGS[$i]}" "$NC" "${MOD_NAMES[$i]}" "$DIM" "${MOD_DESCS[$i]}" "$NC"
  done
}

usage() {
  cat <<USAGE
zafon $VERSION -- apply capablanca customizations over Omarchy

Usage: zafon [command] [flags]

Commands:
  apply           Walk each module needing work and confirm before applying
                  (default when no command is given)
  check           Report drift, change nothing
  list            List available modules

Flags:
  -y, --yes       Skip the per-module prompts; apply everything except optional
      --no-confirm  Same as --yes
  -o, --only M    Comma-separated module slugs (see \`zafon list\`)
  -v, --verbose   Show per-module output while applying
  -s, --silent    Only report problems
      --no-color  Disable colored output
  -h, --help      This message

Environment:
  ZAFON_GRADIENT    always|never|auto (default auto) -- banner gradient
  ZAFON_MODULE_DIR  override the module directory

Exit codes:
  0  everything in place / applied cleanly
  1  drift remains (check) or a module failed (apply)
  3  usage or discovery error
USAGE
}

# ---------------------------------------------------------------------------
# main

COMMAND=""
while (($#)); do
  case $1 in
    check|apply|list) COMMAND=$1 ;;
    -y|--yes|--no-confirm) ASSUME_YES=true ;;
    -v|--verbose) VERBOSE=true ;;
    -s|--silent) SILENT=true ;;
    --no-color) USE_COLOR=false ;;
    -o|--only) shift; ONLY=${1:-} ;;
    --only=*) ONLY=${1#*=} ;;
    -h|--help) setup_colors; usage; exit 0 ;;
    *) err "unknown argument: $1"; err "try: zafon --help"; exit 3 ;;
  esac
  shift
done

setup_colors
discover

# Bare `zafon` applies (with a prompt per module) rather than only reporting.
case ${COMMAND:-apply} in
  check) cmd_check ;;
  apply) cmd_apply ;;
  list)  cmd_list ;;
esac
