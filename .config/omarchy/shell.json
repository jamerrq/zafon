{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.elsewhen",
          "zones": "Bogota|America/Bogota, London|Europe/London, Dubai|Asia/Dubai, Tokyo|Asia/Tokyo, Honolulu|Pacific/Honolulu"
        },
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "arch",
          "type": "qml"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "jamerrq.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "jamerrq.osd",
    "io.github.sirjul1337.lock-explorer"
  ],
  "disabledPlugins": [
    "omarchy.osd",
    "omarchy.lock"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "jamerrq.osd"
    },
    {
      "boot": "eyes",
      "design": "poster",
      "id": "io.github.sirjul1337.lock-explorer",
      "unlock": "fade"
    }
  ],
  "version": 1
}
